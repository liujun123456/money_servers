<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.mapper.FlowInvestorMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="org.example.entity.FlowInvestor">
        <id column="id" property="id" />
        <result column="ts_code" property="tsCode" />
        <result column="ann_date" property="annDate" />
        <result column="end_date" property="endDate" />
        <result column="holder_name" property="holderName" />
        <result column="hold_amount" property="holdAmount" />
        <result column="hold_ratio" property="holdRatio" />
        <result column="hold_float_ratio" property="holdFloatRatio" />
        <result column="hold_chane" property="holdChange" />
        <result column="holder_type" property="holderType" />
        <result column="act_ent_type" property="actEntType" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>


    <!-- 批量插入 -->
    <insert id="batchInsert" parameterType="list">
        INSERT INTO flow_investor (ts_code, ann_date, end_date, holder_name, hold_amount,hold_ratio,hold_float_ratio,hold_chane,holder_type,act_ent_type)
        VALUES
        <foreach collection="flowInvestors" item="flow" separator=",">
            (#{flow.tsCode}, #{flow.annDate}, #{flow.endDate},
            #{flow.holderName}, #{flow.holdAmount}, #{flow.holdRatio}, #{flow.holdFloatRatio}, #{flow.holdChange}, #{flow.holderType}, #{flow.actEntType})
        </foreach>
    </insert>
</mapper>